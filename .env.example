# Copier en .env pour le développement local (jamais commité).
# En production, ces variables sont définies dans la stack Portainer.

PORT=3000
# Dossier de la base SQLite et des photos (/data dans le conteneur)
DATA_DIR=./data
# Adresse publique de l'API, utilisée pour les URL des photos (sans / final)
PUBLIC_URL=http://localhost:3000
# Secret de signature des jetons (au moins 32 caractères) : openssl rand -base64 48
JWT_SECRET=
# Origines autorisées par CORS, séparées par des virgules (back-office, Expo web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# RGPD : durée de conservation des mesures et du journal, en jours
RETENTION_DAYS=30
# Taille maximale d'une photo envoyée, en Mo
MAX_UPLOAD_MB=15

# Amorçage (créés au démarrage s'ils n'existent pas)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
TERMINAL_ID=pi-salon
# Clé du terminal (Raspberry Pi) : openssl rand -base64 32
TERMINAL_KEY=
EVENT_NAME=Soirée de démonstration
EVENT_CODE=MANORA
